# Allow lifecycle scripts (prisma generate, esbuild install, etc.)
enable-pre-post-scripts=true

# Hoist all packages to root node_modules — avoids symlink-race issues
# when Vercel re-runs pnpm install for serverless function bundles
shamefully-hoist=true

# Explicitly allow build scripts for packages that need them
# (pnpm 10 blocks these by default)
package-manager-strict=false
