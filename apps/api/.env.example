# =============================================================================
# Real Estate CRM — API Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # SERVER ONLY — never expose to browser
SUPABASE_JWT_SECRET="<jwt-secret>"               # Settings → API → JWT Secret

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Local dev (Supabase CLI): port 54322
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Production: use Session pooler URL from Supabase Dashboard → Settings → Database
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Upstash Redis (serverless rate limiting + token store) ───────────────────
# Get free tier at https://upstash.com — create a Redis database, copy REST URL/token
UPSTASH_REDIS_REST_URL="https://<id>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"

# ─── Vercel Cron protection ───────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET="change-me-min-32-chars-for-cron-protection"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"
COOKIE_SECRET="change-me-min-32-chars-random-string"

# ─── Supabase Storage (replaces S3/MinIO) ─────────────────────────────────────
SUPABASE_STORAGE_DOCUMENTS_BUCKET="recrm-documents"
SUPABASE_STORAGE_AVATARS_BUCKET="recrm-avatars"

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=null
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORG_ID=
# NOTE: SUPABASE_ANON_KEY is a browser-safe public key.
# It belongs in apps/web/.env.example — NOT here (API never needs it).
# Phase G — Additional storage bucket
SUPABASE_STORAGE_PROPERTY_BUCKET="recrm-property"
# S3/MinIO vars removed in Phase G (replaced by Supabase Storage):
# S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET no longer needed

# ─── Phase K: Data migration ──────────────────────────────────────────────────
# SOURCE_DATABASE_URL=postgresql://...   (old DB — only needed during migration)
# MIGRATION_DEFAULT_PASSWORD=ChangeMe@2024!
