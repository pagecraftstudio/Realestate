# =============================================================================
# Real Estate CRM — Web (Next.js) Environment Variables
# =============================================================================

# ─── Supabase (public — safe to expose to browser) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# ─── Supabase Service Role (server only — NEVER expose to browser) ────────────
# Used by Next.js Route Handlers to query DB with admin privileges
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# ─── App URL (used for server-side API calls) ─────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron security ────────────────────────────────────────────────────────────
CRON_SECRET="<random-secret>"
