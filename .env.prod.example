# ─── App security ─────────────────────────────────────────────────────────────
# Min 32 random chars — generate with: openssl rand -hex 32
COOKIE_SECRET=change-me-min-32-random-chars
# Comma-separated allowed origins
CORS_ORIGIN=https://your-app.com

